<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageDescription>AppHost-only local Keycloak proof conventions for AppSurface OpenID Connect authentication.</PackageDescription>
    <PackageTags>appsurface;dotnet;aspire;authentication;oidc;keycloak</PackageTags>
    <RealmReadyWorkerAssemblyName>ForgeTrust.AppSurface.Auth.Aspire.Keycloak.RealmReadyWorker</RealmReadyWorkerAssemblyName>
    <RealmReadyWorkerProject>$(MSBuildProjectDirectory)/realm-ready/ForgeTrust.AppSurface.Auth.Aspire.Keycloak.RealmReadyWorker.csproj</RealmReadyWorkerProject>
    <RealmReadyWorkerPackageClosureDirectory>$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/realm-ready-package/</RealmReadyWorkerPackageClosureDirectory>
    <RealmReadyWorkerPublishDirectory>$(RealmReadyWorkerPackageClosureDirectory)publish/</RealmReadyWorkerPublishDirectory>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);AddRealmReadyWorkerToPackage</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="realm-ready/**/*.cs" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Auth.Aspire.Keycloak.Tests" />
    <ProjectReference Include="../ForgeTrust.AppSurface.Auth.Keycloak/ForgeTrust.AppSurface.Auth.Keycloak.csproj" />
    <ProjectReference Include="../../Aspire/ForgeTrust.AppSurface.Aspire/ForgeTrust.AppSurface.Aspire.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.Keycloak" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive/ForgeTrust.AppSurface.Auth.Aspire.Keycloak.targets" Pack="true" PackagePath="buildTransitive/" />
  </ItemGroup>

  <Target Name="BuildRealmReadyWorker">
    <RemoveDir Directories="$(RealmReadyWorkerPackageClosureDirectory)" />
    <MakeDir Directories="$(RealmReadyWorkerPublishDirectory)" />
    <MSBuild
      Projects="$(RealmReadyWorkerProject)"
      Targets="Restore"
      Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework)" />
    <MSBuild
      Projects="$(RealmReadyWorkerProject)"
      Targets="Publish"
      Properties="Configuration=$(Configuration);NoBuild=false;TargetFramework=$(TargetFramework);RuntimeIdentifier=;SelfContained=false;UseAppHost=false;PublishSingleFile=false;DebugType=None;DebugSymbols=false;UseSharedCompilation=false;BuildProjectReferences=false;PublishDir=$(RealmReadyWorkerPublishDirectory)" />
  </Target>

  <Target Name="AddRealmReadyWorkerToPackage" DependsOnTargets="BuildRealmReadyWorker">
    <ItemGroup>
      <_RealmReadyWorkerPublishedFile Include="$(RealmReadyWorkerPublishDirectory)**/*" />
    </ItemGroup>

    <Error
      Condition="'@(_RealmReadyWorkerPublishedFile)' == ''"
      Text="The realm-ready worker publish closure is empty at '$(RealmReadyWorkerPublishDirectory)'." />
    <Error
      Condition="!Exists('$(RealmReadyWorkerPublishDirectory)$(RealmReadyWorkerAssemblyName).dll')"
      Text="The realm-ready worker publish closure is missing $(RealmReadyWorkerAssemblyName).dll." />
    <Error
      Condition="!Exists('$(RealmReadyWorkerPublishDirectory)$(RealmReadyWorkerAssemblyName).deps.json')"
      Text="The realm-ready worker publish closure is missing $(RealmReadyWorkerAssemblyName).deps.json." />
    <Error
      Condition="!Exists('$(RealmReadyWorkerPublishDirectory)$(RealmReadyWorkerAssemblyName).runtimeconfig.json')"
      Text="The realm-ready worker publish closure is missing $(RealmReadyWorkerAssemblyName).runtimeconfig.json." />

    <ItemGroup>
      <TfmSpecificPackageFile Include="$(RealmReadyWorkerPublishDirectory)**/*">
        <PackagePath>tools/$(TargetFramework)/any/realm-ready/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
