<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageDescription>Explicit consumer-owned Aspire lifecycle integration for AppSurface EvidenceHost producers and readiness checks.</PackageDescription>
    <PackageTags>appsurface;evidence;aspire;ci;testing;e2e</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <NoWarn>$(NoWarn);ASPIREPIPELINES001;ASPIREFILESYSTEM001;ASPIREUSERSECRETS001</NoWarn>
    <DefineConstants Condition="'$(EvidencePrivateQualification)' == 'C3Sdk' and '$(EvidencePrivateC3SdkLifecycleStall)' == 'ConfigureSync'">$(DefineConstants);EVIDENCE_PRIVATE_C3SDK_CONFIGURE_SYNC_STALL</DefineConstants>
    <DefineConstants Condition="'$(EvidencePrivateQualification)' == 'C3Sdk' and '$(EvidencePrivateC3SdkLifecycleStall)' == 'RegisteredDisposer'">$(DefineConstants);EVIDENCE_PRIVATE_C3SDK_REGISTERED_DISPOSER_STALL</DefineConstants>
    <DefineConstants Condition="'$(EvidencePrivateQualification)' == 'C3Sdk' and '$(EvidencePrivateC3SdkPostStopGuards)' == 'true'">$(DefineConstants);EVIDENCE_PRIVATE_C3SDK_POST_STOP_GUARDS</DefineConstants>
  </PropertyGroup>

  <Target Name="ValidatePrivateC3SdkLifecycleStall" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(EvidencePrivateC3SdkLifecycleStall)' != '' and '$(EvidencePrivateQualification)' != 'C3Sdk'"
           Text="EvidencePrivateC3SdkLifecycleStall is permitted only for EvidencePrivateQualification=C3Sdk." />
    <Error Condition="'$(EvidencePrivateC3SdkLifecycleStall)' != '' and '$(EvidencePrivateC3SdkLifecycleStall)' != 'ConfigureSync' and '$(EvidencePrivateC3SdkLifecycleStall)' != 'RegisteredDisposer'"
           Text="EvidencePrivateC3SdkLifecycleStall must be ConfigureSync or RegisteredDisposer." />
    <Error Condition="'$(EvidencePrivateC3SdkPostStopGuards)' != '' and '$(EvidencePrivateC3SdkPostStopGuards)' != 'true' and '$(EvidencePrivateC3SdkPostStopGuards)' != 'false'"
           Text="EvidencePrivateC3SdkPostStopGuards must be true or false." />
    <Error Condition="'$(EvidencePrivateC3SdkPostStopGuards)' != '' and '$(EvidencePrivateQualification)' != 'C3Sdk'"
           Text="EvidencePrivateC3SdkPostStopGuards is permitted only for EvidencePrivateQualification=C3Sdk." />
    <Error Condition="'$(EvidencePrivateC3SdkPostStopGuards)' == 'true' and '$(EvidencePrivateC3SdkLifecycleStall)' != ''"
           Text="EvidencePrivateC3SdkPostStopGuards cannot be combined with EvidencePrivateC3SdkLifecycleStall." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" VersionOverride="[13.4.4,14.0.0)" />
    <ProjectReference Include="../ForgeTrust.AppSurface.Evidence.Contracts/ForgeTrust.AppSurface.Evidence.Contracts.csproj" />
    <ProjectReference Include="../ForgeTrust.AppSurface.Evidence.Coverage/ForgeTrust.AppSurface.Evidence.Coverage.csproj" />
    <ProjectReference Include="../ForgeTrust.AppSurface.Evidence.Planner/ForgeTrust.AppSurface.Evidence.Planner.csproj" />
    <ProjectReference Include="../ForgeTrust.AppSurface.Evidence.Readiness/ForgeTrust.AppSurface.Evidence.Readiness.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Aspire.Tests" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
