<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageDescription>Deterministic diff-to-policy planning and manifest claim evaluation for AppSurface evidence.</PackageDescription>
    <PackageTags>appsurface;evidence;ci;planner;coverage;e2e</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ForgeTrust.AppSurface.Evidence.Contracts/ForgeTrust.AppSurface.Evidence.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Evidence.Aspire" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Evidence.Cli" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Evidence.Supervision" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Cli" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Cli.Tests" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Aspire.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(EvidencePrivateQualification)' == 'C3' or '$(EvidencePrivateQualification)' == 'C3Sdk'">
    <Compile Include="$(EvidenceC3RegistrationSource)" />
  </ItemGroup>
  <Target Name="RequirePrivateC3RegistrationSource" BeforeTargets="CoreCompile"
          Condition="'$(EvidencePrivateQualification)' == 'C3' or '$(EvidencePrivateQualification)' == 'C3Sdk'">
    <Error Condition="'$(EvidenceC3RegistrationSource)' == '' or !Exists('$(EvidenceC3RegistrationSource)')"
           Text="Private C3 images require the independently generated immutable registration source." />
  </Target>
</Project>
