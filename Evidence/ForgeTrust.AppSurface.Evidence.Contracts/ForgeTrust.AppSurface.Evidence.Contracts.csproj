<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PackageDescription>Versioned public contracts for deterministic AppSurface CI evidence plans, producers, manifests, and claims.</PackageDescription>
    <PackageTags>appsurface;evidence;ci;testing;contracts;coverage;e2e</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Evidence.Aspire" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Evidence.Cli" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Evidence.Coverage" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Evidence.Planner" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Cli" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Cli.Tests" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Aspire.Tests" />
    <InternalsVisibleTo Include="EvidenceHost.LifecycleWorker" />
    <InternalsVisibleTo Include="EvidenceHost.ControlProtocolWorker" />
  </ItemGroup>

</Project>
