  "rules": [
    { "id": "documentation-reference", "pattern": "docs/*.md", "profileId": "documentation-only" },
    { "id": "documentation-guides", "pattern": "guides/*.md", "profileId": "documentation-only" },
    { "id": "documentation-start-here", "pattern": "start-here/*.md", "profileId": "documentation-only" },
    { "id": "documentation-root-readme", "pattern": "README.md", "profileId": "documentation-only" },
    { "id": "documentation-contributor-guide", "pattern": "CONTRIBUTING.md", "profileId": "documentation-only" },
    { "id": "control-github", "pattern": ".github/**", "profileId": "pr-conservative" },
    { "id": "control-policy", "pattern": ".appsurface/**", "profileId": "pr-conservative" },
    { "id": "control-design-documents", "pattern": "docs/designs/**", "profileId": "pr-conservative" },
    { "id": "control-issue-plans", "pattern": "docs/plans/**", "profileId": "pr-conservative" },
    { "id": "control-policy-matrix", "pattern": "docs/evidence-gate-policy-matrix.md", "profileId": "pr-conservative" },
    { "id": "control-rollout-guide", "pattern": "docs/evidence-gate-rollout.md", "profileId": "pr-conservative" },
    { "id": "control-diagnostics-guide", "pattern": "docs/evidence-gate-diagnostics.md", "profileId": "pr-conservative" },
    { "id": "control-scripts", "pattern": "scripts/**", "profileId": "pr-conservative" },
    { "id": "control-agent-guidance", "pattern": "AGENTS.md", "profileId": "pr-conservative" },
    { "id": "control-nested-agent-guidance", "pattern": "**/AGENTS.md", "profileId": "pr-conservative" },
    { "id": "control-evidence-implementation", "pattern": "Evidence/**", "profileId": "pr-conservative" },
    { "id": "control-evidence-cli", "pattern": "Cli/ForgeTrust.AppSurface.Cli/**", "profileId": "pr-conservative" },
    { "id": "control-evidence-cli-tests", "pattern": "Cli/ForgeTrust.AppSurface.Cli.Tests/**", "profileId": "pr-conservative" },
    { "id": "coverage-csharp", "pattern": "**/*.cs", "profileId": "code-coverage" },
    { "id": "package-project-files", "pattern": "**/*.csproj", "profileId": "package-release-preparation" },
    { "id": "unknown-typescript", "pattern": "**/*.ts", "profileId": "pr-conservative" },
    { "id": "unknown-tsx", "pattern": "**/*.tsx", "profileId": "pr-conservative" },
    { "id": "unknown-javascript", "pattern": "**/*.js", "profileId": "pr-conservative" },
    { "id": "unknown-css", "pattern": "**/*.css", "profileId": "pr-conservative" },
    { "id": "unknown-scss", "pattern": "**/*.scss", "profileId": "pr-conservative" },
    { "id": "unknown-razor", "pattern": "**/*.razor", "profileId": "pr-conservative" },
    { "id": "unknown-sql", "pattern": "**/*.sql", "profileId": "pr-conservative" },
