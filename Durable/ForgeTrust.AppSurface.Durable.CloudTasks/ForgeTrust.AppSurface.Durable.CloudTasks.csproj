<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Description>Explicitly credentialed, bounded payload-free Google Cloud Tasks activation transport.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Google.Cloud.Tasks.V2" />
    <PackageReference Include="Grpc.Net.Client" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Durable.CloudTasks.Tests" />
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
