<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>ForgeTrust.AppSurface.Durable.PostgreSql.TestHost</AssemblyName>
    <PackageId>ForgeTrust.AppSurface.Durable.PostgreSql.V2WorkHarness</PackageId>
    <IsPackable>false</IsPackable>
    <V2PackageVersion>0.2.0-preview.8</V2PackageVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ForgeTrust.AppSurface.Durable.PostgreSql"
                      VersionOverride="[$(V2PackageVersion)]" />
  </ItemGroup>

  <!-- The CI verifier redirects intermediates to a temporary directory; never treat a prior local obj tree as source. -->
  <ItemGroup>
    <Compile Remove="obj/**/*.cs" />
  </ItemGroup>

  <Target Name="RequireV2CompatibilityPackage"
          BeforeTargets="Restore;Build">
    <Error Condition="'$(V2PackageVersion)' != '0.2.0-preview.8'"
           Text="V2WorkHarness must restore and build against exactly ForgeTrust.AppSurface.Durable.PostgreSql 0.2.0-preview.8." />
  </Target>

</Project>
