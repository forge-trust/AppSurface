<Project Sdk="Microsoft.NET.Sdk">
  <!-- The smoke stages this project alongside the extracted package targets and references. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>ForgeTrust.AppSurface.Auth.Aspire.Keycloak.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <!-- The offline fixture tests the real published process without restoring analyzer packages. -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ForgeTrust.AppSurface.Auth.Aspire.Keycloak" HintPath="references/ForgeTrust.AppSurface.Auth.Aspire.Keycloak.dll" />
    <Reference Include="ForgeTrust.AppSurface.Auth.Keycloak" HintPath="references/ForgeTrust.AppSurface.Auth.Keycloak.dll" />
    <Reference Include="ForgeTrust.AppSurface.Core" HintPath="references/ForgeTrust.AppSurface.Core.dll" />
  </ItemGroup>
  <Import Project="adapter/buildTransitive/ForgeTrust.AppSurface.Auth.Aspire.Keycloak.targets" />
</Project>
