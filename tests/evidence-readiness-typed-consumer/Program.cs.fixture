using Aspire.Hosting;
using Aspire.Hosting.ApplicationModel;
using CliFx.Binding;
using ForgeTrust.AppSurface.Aspire;
using ForgeTrust.AppSurface.Aspire.Testing;
using ForgeTrust.AppSurface.Core;
using ForgeTrust.AppSurface.Evidence.Readiness;
using Microsoft.AspNetCore.Builder;
using Microsoft.AspNetCore.Hosting;
using Microsoft.AspNetCore.Http;
using Microsoft.Extensions.DependencyInjection;
using Microsoft.Extensions.Hosting;
using Microsoft.Extensions.Logging;
using System.Text.Json;
using System.Reflection;
using System.Runtime.InteropServices;

namespace EvidenceReadinessTypedConsumer;

public static class Program
{
    private const string SkoolitSourceCommit = "a589f164ef3346d4ecf8bf39b8a73ec71ea1cb1e";
    internal const string ResourceName = "skoolit-web";
    internal const string EndpointName = "http";
    internal const string ProbePath = "/healthz";
    private static readonly TimeSpan StartupTimeout = TimeSpan.FromMinutes(3);
    private static readonly TimeSpan RequestTimeout = TimeSpan.FromSeconds(3);
    private static readonly TimeSpan RetryDelay = TimeSpan.FromMilliseconds(250);
    private static readonly TimeSpan ConnectTimeout = TimeSpan.FromSeconds(2);
    private const int MaximumAttempts = 30;

    public static async Task<int> Main(string[] args)
    {
        if (args is ["--health-server"])
        {
            return await RunHealthServerAsync();
        }

        var packageVersion = RequiredArgument(args, "--package-version");
        var sourceCommit = RequiredArgument(args, "--source-commit");
        var sourceTreeStatus = RequiredArgument(args, "--source-tree-status");
        AssertTypedRestoreClosure(packageVersion);
        AssertNativeDcpMetadata();

        await RunPinnedGateEquivalentAsync("monitoring-receipt", CancellationToken.None);
        await RunPinnedGateEquivalentAsync("billing-tier", CancellationToken.None);

        Console.WriteLine(
            $"READINESS_TYPED_CONSUMER_OK proofKind=packed-typed-fixture-real-process-gate-equivalence " +
            $"packageId=ForgeTrust.AppSurface.Aspire.Testing packageVersion={packageVersion} " +
            $"sourceCommit={sourceCommit} skoolitSourceCommit={SkoolitSourceCommit} " +
            $"sourceTree={sourceTreeStatus} " +
            "resource=skoolit-web endpoint=http path=/healthz aspire=13.4.4 " +
            "startupTimeout=3m maxAttempts=30 requestTimeout=3s retryDelay=250ms useProxy=false connectTimeout=2s " +
            "nativeDcpMetadata=present timing=unmeasured");
        return 0;
    }

    private static async Task RunPinnedGateEquivalentAsync(string gate, CancellationToken cancellationToken)
    {
        using var callerTimeout = new CancellationTokenSource(StartupTimeout);
        using var linkedCallerToken = CancellationTokenSource.CreateLinkedTokenSource(cancellationToken, callerTimeout.Token);
        var options = new AppSurfaceAspireStartupOptions
        {
            StartupTimeout = StartupTimeout,
            Http = new HttpReadinessOptions
            {
                RequestTimeout = RequestTimeout,
                RetryDelay = RetryDelay,
                MaxAttempts = MaximumAttempts,
            },
            CreateProbeClient = endpoint => new HttpClient(new SocketsHttpHandler
            {
                UseProxy = false,
                ConnectTimeout = ConnectTimeout,
            })
            {
                BaseAddress = endpoint,
                Timeout = RequestTimeout,
            },
        };

        await using var fixture = await AppSurfaceAspireTestFixture.StartAsync(
            token => AppSurfaceAspireTestingBuilder.CreateConfiguredAsync<
                ConsumerAppHost,
                ConsumerModule,
                ConsumerProfile>(new AppSurfaceAspireTestingOptions
                {
                    ConfigureActivationServices = services => services.AddSingleton(new GateScenario(gate)),
                }, token),
            new AspireHttpReadinessTarget(ResourceName, EndpointName, ProbePath),
            options,
            linkedCallerToken.Token);

        if (!fixture.Endpoint.IsAbsoluteUri || fixture.Endpoint.Scheme != Uri.UriSchemeHttp)
        {
            throw new InvalidOperationException("The typed readiness fixture did not return its allocated HTTP endpoint.");
        }

        Console.WriteLine(
            $"READINESS_GATE_EQUIVALENCE gate={gate} sourceCommit={SkoolitSourceCommit} " +
            $"resource={ResourceName} endpoint={EndpointName} path={ProbePath} startupTimeout=3m " +
            "maxAttempts=30 requestTimeout=3s retryDelay=250ms useProxy=false connectTimeout=2s " +
            "fixture=completed timing=unmeasured");
    }

    private static async Task<int> RunHealthServerAsync()
    {
        var builder = WebApplication.CreateBuilder();
        builder.WebHost.UseUrls("http://0.0.0.0:8080");
        var application = builder.Build();
        application.MapGet("/healthz", () => Results.Ok());
        await application.RunAsync();
        return 0;
    }

    private static void AssertTypedRestoreClosure(string packageVersion)
    {
        var assetsPath = Path.Join(Environment.CurrentDirectory, "obj", "project.assets.json");
        using var document = JsonDocument.Parse(File.ReadAllText(assetsPath));
        var assets = document.RootElement;
        var libraries = assets.GetProperty("libraries");
        RequirePackage(libraries, "ForgeTrust.AppSurface.Aspire.Testing", packageVersion);
        RequirePackage(libraries, "ForgeTrust.AppSurface.Evidence.Readiness", packageVersion);
        RequirePackage(libraries, "Aspire.Hosting", "13.4.4");
        RequirePackage(libraries, "Aspire.Hosting.AppHost", "13.4.4");
        RequirePackage(libraries, "Aspire.Hosting.Testing", "13.4.4");
        if (libraries.EnumerateObject().Any(library =>
                library.Value.GetProperty("type").GetString()!.Equals("project", StringComparison.OrdinalIgnoreCase)))
        {
            throw new InvalidOperationException("The packed typed consumer restore graph contains project references.");
        }

        var directDependencies = assets.GetProperty("project")
            .GetProperty("frameworks")
            .GetProperty("net10.0")
            .GetProperty("dependencies");
        var explicitDirectIds = directDependencies.EnumerateObject()
            .Where(property => !property.Value.TryGetProperty("autoReferenced", out var autoReferenced) ||
                               !autoReferenced.GetBoolean())
            .Select(property => property.Name)
            .Order(StringComparer.OrdinalIgnoreCase).ToArray();
        if (!explicitDirectIds.SequenceEqual(
                new[] { "Aspire.Hosting.AppHost", "ForgeTrust.AppSurface.Aspire.Testing" }
                    .Order(StringComparer.OrdinalIgnoreCase),
                StringComparer.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException("The typed consumer direct references differ from its prepared package project.");
        }
    }

    private static void RequirePackage(JsonElement libraries, string packageId, string version)
    {
        var entry = libraries.EnumerateObject().SingleOrDefault(library =>
            library.Name.StartsWith($"{packageId}/", StringComparison.OrdinalIgnoreCase));
        if (entry.Equals(default(JsonProperty)) ||
            !entry.Name.Equals($"{packageId}/{version}", StringComparison.OrdinalIgnoreCase) ||
            !entry.Value.GetProperty("type").GetString()!.Equals("package", StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException($"Typed consumer did not restore {packageId}/{version} from the packed feed.");
        }
    }

    private static void AssertNativeDcpMetadata()
    {
        var dcpPath = typeof(ConsumerAppHost).Assembly
            .GetCustomAttributes<AssemblyMetadataAttribute>()
            .SingleOrDefault(attribute => attribute.Key == "dcpclipath")?.Value;
        if (string.IsNullOrWhiteSpace(dcpPath) || !File.Exists(dcpPath))
        {
            throw new InvalidOperationException("The prepared AppHost assembly has no usable native DCP CLI metadata.");
        }

        var expectedArchitecture = RuntimeInformation.ProcessArchitecture switch
        {
            Architecture.Arm64 => "arm64",
            Architecture.X64 => "x64",
            _ => null,
        };
        if (expectedArchitecture is null || !dcpPath.Contains(expectedArchitecture, StringComparison.OrdinalIgnoreCase))
        {
            throw new InvalidOperationException("The prepared AppHost DCP metadata does not match the current process architecture.");
        }
    }

    private static string RequiredArgument(string[] args, string name)
    {
        var index = Array.IndexOf(args, name);
        if (index < 0 || index + 1 >= args.Length || string.IsNullOrWhiteSpace(args[index + 1]))
        {
            throw new ArgumentException($"Expected {name} followed by a value.", nameof(args));
        }

        return args[index + 1];
    }
}

public sealed class ConsumerAppHost
{
    public static string ProjectPath => Path.GetDirectoryName(typeof(ConsumerAppHost).Assembly.Location)!;
}

public sealed class ConsumerModule : IAppSurfaceHostModule
{
    public void ConfigureServices(StartupContext context, IServiceCollection services)
    {
    }

    public void RegisterDependentModules(ModuleDependencyBuilder builder)
    {
    }

    public void ConfigureHostBeforeServices(StartupContext context, IHostBuilder builder)
    {
    }

    public void ConfigureHostAfterServices(StartupContext context, IHostBuilder builder)
    {
    }
}

public sealed record GateScenario(string Name);

[Command("readiness-consumer")]
public sealed partial class ConsumerProfile(GateScenario scenario, ILogger<ConsumerProfile> logger) : AspireProfile(logger)
{
    public override IEnumerable<IAspireComponent> GetComponents()
    {
        if (scenario.Name is not ("monitoring-receipt" or "billing-tier"))
        {
            throw new InvalidOperationException("The per-call constructor scenario was not preserved.");
        }
        return [new WebComponent()];
    }
}

public sealed class WebComponent : IAspireComponent<ExecutableResource>
{
    public IResourceBuilder<ExecutableResource> Generate(
        AspireStartupContext context,
        IDistributedApplicationBuilder appBuilder) =>
        appBuilder.AddExecutable(
                Program.ResourceName,
                "dotnet",
                AppContext.BaseDirectory,
                typeof(Program).Assembly.Location,
                "--health-server")
            .WithHttpEndpoint(targetPort: 8080, name: Program.EndpointName)
            .WithHttpHealthCheck(Program.ProbePath);
}
