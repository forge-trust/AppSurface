{
  "AppSurfaceDocs": {
    "Harvest": {
      "Markdown": {
        "IncludeGlobs": [
          "guides/**/*.md"
        ]
      }
    },
    "Localization": {
      "Enabled": true,
      "DefaultLocale": "en",
      "FallbackMode": "Disabled",
      "Locales": [
        {
          "Code": "en",
          "Label": "English",
          "Lang": "en-US",
          "RoutePrefix": "en"
        },
        {
          "Code": "fr",
          "Label": "Français",
          "Lang": "fr-FR",
          "RoutePrefix": "fr"
        }
      ]
    },
    "Routing": {
      "RouteRootPath": "/docs",
      "DocsRootPath": "/docs"
    }
  }
}
