<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <EvidenceHostPackageVersion Condition="'$(EvidenceHostPackageVersion)' == ''">0.1.0-evidencehost-cleanup.local</EvidenceHostPackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ForgeTrust.AppSurface.Evidence.Aspire" Version="$(EvidenceHostPackageVersion)" />
  </ItemGroup>
</Project>
