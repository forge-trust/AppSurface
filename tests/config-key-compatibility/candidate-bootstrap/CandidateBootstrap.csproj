<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <AppSurfaceCorePackageVersion Condition="'$(AppSurfaceCorePackageVersion)' == ''">0.2.0-candidate</AppSurfaceCorePackageVersion>
    <AppSurfaceConfigPackageVersion Condition="'$(AppSurfaceConfigPackageVersion)' == ''">0.2.0-candidate</AppSurfaceConfigPackageVersion>
    <AppSurfaceLocalSecretsPackageVersion Condition="'$(AppSurfaceLocalSecretsPackageVersion)' == ''">0.2.0-candidate</AppSurfaceLocalSecretsPackageVersion>
    <AppSurfaceGooglePackageVersion Condition="'$(AppSurfaceGooglePackageVersion)' == ''">0.2.0-candidate</AppSurfaceGooglePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ForgeTrust.AppSurface.Core" Version="$(AppSurfaceCorePackageVersion)" />
    <PackageReference Include="ForgeTrust.AppSurface.Config" Version="$(AppSurfaceConfigPackageVersion)" />
    <PackageReference Include="ForgeTrust.AppSurface.Config.LocalSecrets" Version="$(AppSurfaceLocalSecretsPackageVersion)" />
    <PackageReference Include="ForgeTrust.AppSurface.Config.GoogleSecretManager" Version="$(AppSurfaceGooglePackageVersion)" />
  </ItemGroup>
</Project>
