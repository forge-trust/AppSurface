@model RazorWireWebExample.Models.DialogStatusSampleModel

@{
    var idPrefix = ViewData["DialogIdPrefix"] as string ?? string.Empty;
}

<div class="space-y-3">
    <p class="text-sm leading-6 text-slate-700">@Model.Message</p>
    <p id="@(idPrefix + "dialog-proof-after")" class="text-sm font-semibold text-indigo-700">@Model.ProofMessage</p>
</div>
