  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../durable-external-activation/DurableExternalActivationExample.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

