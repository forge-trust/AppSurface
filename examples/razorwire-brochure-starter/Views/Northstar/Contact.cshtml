@{
    ViewData["Title"] = "Contact";
}

<section class="contact-page shell" aria-labelledby="contact-title">
    <div class="contact-intro">
        <p class="eyebrow">Start a conversation</p>
        <h1 id="contact-title">Tell us what you are seeing.</h1>
        <p class="lede">This starter form is a quiet preview of the handoff. It does not deliver a message.</p>
        <p class="contact-note">No message was sent.</p>
        <a class="text-link" href="/thank-you">Preview the no-delivery confirmation</a>
    </div>
    <form class="contact-form" data-contact-mode="demo" method="get" action="/thank-you.html?demo=1">
        <div class="field">
            <label for="contact-name">Your name <span aria-hidden="true">*</span></label>
            <input id="contact-name" type="text" autocomplete="name" required>
        </div>
        <div class="field">
            <label for="contact-email">Email address <span aria-hidden="true">*</span></label>
            <input id="contact-email" type="email" autocomplete="email" required>
        </div>
        <div class="field">
            <label for="contact-context">What are you working through? <span aria-hidden="true">*</span></label>
            <textarea id="contact-context" rows="5" required></textarea>
        </div>
        <button class="button button-primary" type="submit">Continue to preview</button>
        <p class="form-hint">Required fields are marked with an asterisk.</p>
    </form>
</section>
