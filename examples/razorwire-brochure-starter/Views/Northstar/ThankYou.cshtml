@{
    ViewData["Title"] = "Confirmation preview";
}

<section class="confirmation shell" aria-labelledby="confirmation-title">
    <p class="eyebrow">Confirmation preview</p>
    <h1 id="confirmation-title">The handoff is ready.</h1>
