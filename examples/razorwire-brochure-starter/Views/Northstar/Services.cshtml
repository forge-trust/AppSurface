@{
    ViewData["Title"] = "Services";
}

<section class="page-intro shell" aria-labelledby="services-title">
    <p class="eyebrow">What we do</p>
    <h1 id="services-title">Clarity is a creative advantage.</h1>
    <p class="lede">We work with teams at turning points: a new category, a sharper story, a more confident way forward.</p>
</section>

<section class="shell service-list" aria-label="Northstar services">
    <article class="service-row">
        <span class="service-number">01</span>
        <div>
            <h2>Find the north star</h2>
            <p>We make the strategic story legible: the audience, the tension, the promise, and the few decisions that matter most.</p>
        </div>
        <span class="service-type">Strategy</span>
    </article>
    <article class="service-row">
        <span class="service-number">02</span>
        <div>
            <h2>Give it a voice</h2>
            <p>We turn positioning into language systems that hold up across a homepage, a keynote, a product, and a conversation.</p>
        </div>
        <span class="service-type">Editorial</span>
    </article>
    <article class="service-row">
        <span class="service-number">03</span>
        <div>
            <h2>Make it memorable</h2>
            <p>We pair a strong point of view with a visual rhythm so the work feels recognizable before it is explained.</p>
        </div>
        <span class="service-type">Direction</span>
    </article>
</section>

<section class="shell closing-cta" aria-labelledby="services-cta-title">
    <p class="eyebrow">A good place to begin</p>
    <h2 id="services-cta-title">Bring us the knotty version.</h2>
    <a class="button button-primary" href="/contact">Start a conversation</a>
</section>
