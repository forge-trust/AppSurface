<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <AssemblyName>NativePreparation.Subject.Tests</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="calculation/**/*.cs" />
    <PackageReference Include="coverlet.collector">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <ProjectReference Include="calculation/Calculation.csproj" />
  </ItemGroup>
  <UsingTask TaskName="Checkpoint2QuotaOutput" TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <FileName ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        using (var input = System.IO.File.OpenRead(FileName))
        using (var output = System.Console.OpenStandardOutput())
        {
            if (input.Length != 320L * (65536 + 5))
                throw new System.InvalidOperationException("The fixed quota payload is incomplete.");
            input.CopyTo(output, 16384);
            output.Flush();
        }
      ]]></Code>
    </Task>
  </UsingTask>
  <!-- Only the root-selected quota case creates this file, during actual test execution. -->
  <Target Name="Checkpoint2EmitActualQuotaOutput" AfterTargets="VSTest"
          Condition="Exists('$(TMPDIR)/checkpoint2-quota-output.txt')">
    <Checkpoint2QuotaOutput FileName="$(TMPDIR)/checkpoint2-quota-output.txt" />
  </Target>
</Project>
