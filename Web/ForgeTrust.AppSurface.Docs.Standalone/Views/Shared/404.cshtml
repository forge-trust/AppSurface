@using ForgeTrust.AppSurface.Docs
@using ForgeTrust.AppSurface.Docs.Models
@using ForgeTrust.AppSurface.Docs.Services
@using ForgeTrust.AppSurface.Web
@model BrowserStatusPageModel
@inject DocsRecoveryLinkBuilder DocsRecoveryLinkBuilder
@{
    Layout = null;
    var requestPath = string.IsNullOrWhiteSpace(Model.OriginalPath)
        ? "the requested documentation page"
        : Model.OriginalPath;
    var recoveryLinks = DocsRecoveryLinkBuilder.BuildRecoveryLinks();
    var primaryLink = recoveryLinks.First(link => link.Kind == DocsRecoveryLinkKind.Primary);
    var secondaryLinks = recoveryLinks.Where(link => link.Kind == DocsRecoveryLinkKind.Secondary).ToArray();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Documentation page not found</title>
    <style>
        :root {
            color-scheme: light dark;
            /* Static recovery mirrors AppSurfaceThemePair.AppSurface() when the normal Docs shell cannot render. */
            --docs-404-canvas: #f8fafc;
            --docs-404-canvas-mid: #f1f5f9;
            --docs-404-surface: #ffffff;
            --docs-404-text: #0f172a;
            --docs-404-muted: #475569;
            --docs-404-subtle: #64748b;
            --docs-404-border: #64748b;
            --docs-404-accent: #2563eb;
            --docs-404-accent-fill: #1d4ed8;
            --docs-404-accent-text: #ffffff;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            background: var(--docs-404-canvas);
            color: var(--docs-404-text);
        }

        @@media (prefers-color-scheme: dark) {
            :root {
                --docs-404-canvas: #0f172a;
                --docs-404-canvas-mid: #172554;
                --docs-404-surface: #1e293b;
                --docs-404-text: #f8fafc;
                --docs-404-muted: #cbd5e1;
                --docs-404-subtle: #94a3b8;
                --docs-404-border: #94a3b8;
                --docs-404-accent: #60a5fa;
                --docs-404-accent-fill: #93c5fd;
                --docs-404-accent-text: #0f172a;
            }
        }

        @@media (forced-colors: active) {
            :root {
                --docs-404-canvas: Canvas;
                --docs-404-canvas-mid: Canvas;
                --docs-404-surface: Canvas;
                --docs-404-text: CanvasText;
                --docs-404-muted: GrayText;
                --docs-404-subtle: GrayText;
                --docs-404-border: GrayText;
                --docs-404-accent: LinkText;
                --docs-404-accent-fill: Highlight;
                --docs-404-accent-text: HighlightText;
            }

            body {
                background: Canvas;
            }

            code,
            .recovery-row {
                border-color: GrayText;
                background: Canvas;
            }

            .primary-action,
            .primary-action:hover,
            .primary-action:focus-visible,
            .recovery-row:hover,
            .recovery-row:focus-visible {
                outline-color: Highlight;
            }
        }

        body {
            margin: 0;
            min-height: 100vh;
            background:
                linear-gradient(180deg, color-mix(in srgb, var(--docs-404-canvas-mid) 92%, transparent), var(--docs-404-canvas) 42%),
                var(--docs-404-canvas);
            color: var(--docs-404-text);
        }

        main {
            width: min(68rem, calc(100% - 2rem));
            margin: 0 auto;
            padding: clamp(2rem, 7vw, 5rem) 0;
        }

        .eyebrow {
            margin: 0 0 0.9rem;
            color: var(--docs-404-accent);
            font-size: 0.78rem;
            font-weight: 800;
            letter-spacing: 0;
            text-transform: uppercase;
        }

        h1 {
            max-width: 44rem;
            margin: 0 0 1rem;
            font-size: clamp(2.25rem, 4vw, 4.25rem);
            line-height: 1.02;
            letter-spacing: 0;
        }

        .summary {
            max-width: 45rem;
            margin: 0;
            color: var(--docs-404-muted);
            font-size: 1.05rem;
            line-height: 1.7;
        }

        code {
            display: inline;
            padding: 0.12rem 0.35rem;
            border: 1px solid color-mix(in srgb, var(--docs-404-border) 45%, transparent);
            border-radius: 0.35rem;
            background: color-mix(in srgb, var(--docs-404-surface) 82%, transparent);
            color: var(--docs-404-text);
            font-size: 0.95em;
            overflow-wrap: anywhere;
        }

        .actions {
            display: flex;
            flex-wrap: wrap;
            gap: 0.8rem;
            margin-top: 1.75rem;
        }

        .primary-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 2.75rem;
            padding: 0 1.1rem;
            border: 1px solid var(--docs-404-accent-fill);
            border-radius: 0.5rem;
            background: var(--docs-404-accent-fill);
            color: var(--docs-404-accent-text);
            font-weight: 700;
            text-decoration: none;
        }

        .primary-action:hover,
        .primary-action:focus-visible,
        .recovery-row:hover,
        .recovery-row:focus-visible {
            outline: 3px solid color-mix(in srgb, var(--docs-404-accent-fill) 42%, transparent);
            outline-offset: 3px;
            text-decoration: none;
        }

        .browse {
            margin-top: clamp(2rem, 5vw, 3rem);
        }

        .browse h2 {
            margin: 0 0 0.9rem;
            color: var(--docs-404-text);
            font-size: 1rem;
            letter-spacing: 0;
        }

        .recovery-list {
            display: grid;
            gap: 0.75rem;
            max-width: 46rem;
        }

        .recovery-row {
            display: grid;
            grid-template-columns: minmax(8rem, 11rem) 1fr;
            gap: 1rem;
            min-height: 3.5rem;
            padding: 0.95rem 1rem;
            border: 1px solid color-mix(in srgb, var(--docs-404-border) 40%, transparent);
            border-radius: 0.5rem;
            background: color-mix(in srgb, var(--docs-404-surface) 74%, transparent);
            color: var(--docs-404-text);
            text-decoration: none;
        }

        .recovery-title {
            color: var(--docs-404-text);
            font-weight: 800;
        }

        .recovery-description {
            color: var(--docs-404-subtle);
            line-height: 1.45;
        }

        @@media (max-width: 42rem) {
            main {
                padding-top: 2rem;
            }

            .actions,
            .primary-action {
                width: 100%;
            }

            .recovery-row {
                grid-template-columns: 1fr;
                gap: 0.3rem;
            }
        }
    </style>
</head>
<body>
<main>
    <p class="eyebrow">AppSurface Docs</p>
    <h1>Documentation page not found</h1>
    <p class="summary">We couldn't open <code>@requestPath</code>. The page may have moved, or the link may point at an older docs route.</p>
    <nav class="actions" aria-label="Documentation recovery actions">
        <a class="primary-action" href="@Url.PathBaseAware(primaryLink.Href)">@primaryLink.Title</a>
    </nav>
    <section class="browse" aria-labelledby="browse-heading">
        <h2 id="browse-heading">Browse trusted entry points</h2>
        <div class="recovery-list">
            @foreach (var link in secondaryLinks)
            {
                <a class="recovery-row" href="@Url.PathBaseAware(link.Href)" data-rw-export-ignore="@(link.IgnoreDuringStaticExport ? "true" : null)">
                    <span class="recovery-title">@link.Title</span>
                    <span class="recovery-description">@link.Description</span>
                </a>
            }
        </div>
    </section>
</main>
</body>
</html>
