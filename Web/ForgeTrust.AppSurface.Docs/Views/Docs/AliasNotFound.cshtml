@model string
@{
    ViewData["Title"] = "Documentation page not found";
    ViewData["SuppressSidebar"] = true;
}
<section class="docs-version-archive mx-auto max-w-4xl px-4 py-10">
    <h1 class="text-3xl font-bold">Documentation page not found</h1>
    <p class="docs-version-archive__orientation mt-4 text-base">The requested page is not available at this documentation URL.</p>
    <a class="docs-action-link docs-version-archive__action mt-6 inline-flex min-h-11 items-center rounded px-3 py-2 font-medium focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4"
       data-turbo-frame="_top"
       href="@Url.PathBaseAware(Model)">Browse documentation versions</a>
</section>
