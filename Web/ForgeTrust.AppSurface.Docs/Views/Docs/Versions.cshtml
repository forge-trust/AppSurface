@model ForgeTrust.AppSurface.Docs.Models.AppSurfaceDocsVersionArchiveViewModel
@{
    ViewData["Title"] = "Documentation versions";
}

<div class="docs-version-archive grid gap-8">
    <header class="grid gap-4">
        <h1 class="docs-version-archive__title m-0 text-[clamp(2rem,4vw,3rem)] font-bold leading-[1.02]">Documentation versions</h1>
        <p class="docs-version-archive__orientation m-0 max-w-[52rem]">@Model.Description</p>
        @if (!string.IsNullOrWhiteSpace(Model.AvailabilityMessage))
        {
            <p class="docs-version-archive__availability m-0 text-base leading-[1.6]">@Model.AvailabilityMessage</p>
        }

        <section class="grid gap-3" aria-labelledby="docs-version-actions-heading">
            <h2 id="docs-version-actions-heading" class="docs-version-archive__section-title m-0">Documentation actions</h2>
            <div class="flex flex-wrap gap-3">
                <a href="@Url.PathBaseAware(Model.PreviewHref)"
                   data-turbo-frame="_top"
                   class="docs-action-link docs-version-archive__action inline-flex items-center justify-center rounded-full px-4 py-2 text-base font-semibold no-underline transition-colors">
                    Open live source docs
                </a>
                <a href="@Url.PathBaseAware(Model.VersionsHref)"
                   data-turbo-frame="_top"
                   class="docs-version-archive__action inline-flex items-center justify-center rounded-full border border-slate-700 bg-slate-900/70 px-4 py-2 text-base font-semibold text-slate-100 underline decoration-slate-400 underline-offset-4 transition-colors hover:border-slate-500 hover:text-white">
                    Refresh archive
                </a>
            </div>
        </section>
    </header>

    @if (Model.Aliases.Count > 0)
    {
        <section class="grid gap-4" aria-labelledby="docs-version-aliases-heading">
            <div class="grid gap-2">
                <h2 id="docs-version-aliases-heading" class="docs-version-archive__section-title m-0">Named release entries</h2>
                <p class="docs-version-archive__orientation m-0">These labels can move to another release. Exact release URLs stay fixed.</p>
            </div>
            <div class="docs-version-alias-grid">
                @foreach (var alias in Model.Aliases)
                {
                    var aliasLabel = string.IsNullOrWhiteSpace(alias.Label) ? alias.Name : alias.Label;
                    <article class="docs-version-alias-row">
                        <div class="docs-version-alias-row__identity">
                            <h3 class="docs-version-alias-row__label">@aliasLabel</h3>
                            <code class="docs-version-alias-row__name">@alias.Name</code>
                        </div>

                        <div class="docs-version-alias-row__details">
                            @if (!string.IsNullOrWhiteSpace(alias.TargetVersion))
                            {
                                <p class="docs-version-alias-card__target">Exact release <code>@alias.TargetVersion</code>.</p>
                            }

                            @if (!string.IsNullOrWhiteSpace(alias.SupportStateLabel) || !string.IsNullOrWhiteSpace(alias.AdvisoryLabel))
                            {
                                <div class="docs-version-alias-card__warnings">
                                    @if (!string.IsNullOrWhiteSpace(alias.SupportStateLabel))
                                    {
                                        <span class="docs-version-alias-card__badge">@alias.SupportStateLabel</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(alias.AdvisoryLabel))
                                    {
                                        <span class="docs-version-alias-card__badge docs-version-alias-card__badge--warning">@alias.AdvisoryLabel</span>
                                    }
                                </div>
                            }

                            @if (!string.IsNullOrWhiteSpace(alias.Summary))
                            {
                                <p class="docs-version-alias-card__explanation">@alias.Summary</p>
                            }
                            @if (!string.IsNullOrWhiteSpace(alias.AvailabilityMessage))
                            {
                                <p class="docs-version-alias-card__explanation docs-version-archive__availability">@alias.AvailabilityMessage</p>
                            }
                        </div>

                        <div class="docs-version-alias-row__action">
                            @if (alias.IsAvailable && !string.IsNullOrWhiteSpace(alias.Href) && !string.IsNullOrWhiteSpace(alias.TargetVersion))
                            {
                                <a href="@Url.PathBaseAware(alias.Href)"
                                   aria-label="Open @aliasLabel documentation for exact release @alias.TargetVersion"
                                   data-turbo-frame="_top"
                                   class="docs-action-link docs-version-archive__action inline-flex items-center justify-center rounded-full px-4 py-2 text-base font-semibold no-underline transition-colors">
                                    Open @aliasLabel documentation (@alias.TargetVersion)
                                </a>
                            }
                        </div>
                    </article>
                }
            </div>
        </section>
    }

    <section class="grid gap-4" aria-labelledby="docs-exact-releases-heading">
        <h2 id="docs-exact-releases-heading" class="docs-version-archive__section-title m-0">Exact releases</h2>
        @if (Model.Versions.Count == 0)
        {
            <p class="docs-version-card m-0 rounded-lg p-6 text-base leading-[1.65] text-slate-300">
                No published versions are currently listed in the configured archive catalog.
            </p>
        }
        else
        {
            <div class="grid gap-4">
                @foreach (var version in Model.Versions)
                {
                    <article class="docs-version-card grid gap-3 rounded-lg p-5">
                        <div class="flex flex-wrap items-center gap-2">
                            <h2 class="m-0 text-xl font-semibold text-slate-50">@version.Label</h2>
                            <span class="rounded-full border border-slate-700 bg-slate-900 px-2.5 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-slate-300">@version.SupportStateLabel</span>
                            @if (version.IsRecommended)
                            {
                                <span class="docs-status-badge--recommended rounded-full border px-2.5 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.16em]">Recommended</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(version.AdvisoryLabel))
                            {
                                <span class="rounded-full border border-rose-400/35 bg-rose-500/10 px-2.5 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-rose-200">@version.AdvisoryLabel</span>
                            }
                        </div>

                        <p class="m-0 text-sm text-slate-400">
                            @if (!string.IsNullOrWhiteSpace(version.Summary))
                            {
                                @version.Summary
                            }
                            else
                            {
                                <text>Exact version <code>@version.Version</code>.</text>
                            }
                        </p>

                        @if (version.IsAvailable && !string.IsNullOrWhiteSpace(version.Href))
                        {
                            <a href="@Url.PathBaseAware(version.Href)"
                               data-turbo-frame="_top"
                               class="docs-action-link inline-flex items-center gap-2 rounded-full px-4 py-2 text-sm font-semibold no-underline transition-colors">
                                Open @version.Version
                            </a>
                        }
                        else if (!string.IsNullOrWhiteSpace(version.AvailabilityMessage))
                        {
                            <p class="m-0 text-sm leading-[1.55] text-amber-200">@version.AvailabilityMessage</p>
                        }
                    </article>
                }
            </div>
        }
    </section>
</div>
