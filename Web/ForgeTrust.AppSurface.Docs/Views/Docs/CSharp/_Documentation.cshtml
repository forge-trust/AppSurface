    <div class="doc-exceptions">
        @await Html.PartialAsync("/Views/Docs/CSharp/_DocumentationHeading.cshtml", "Exceptions")
        <ul>
            @foreach (var documentationSection in exceptions)
            {
                <li>
                    @if (!string.IsNullOrWhiteSpace(documentationSection.CrefDisplay))
                    {
                        <code data-csharp-cref="@documentationSection.CrefTarget">@documentationSection.CrefDisplay</code>
                    }
                    <div>@await Html.PartialAsync("/Views/Docs/CSharp/_XmlNodes.cshtml", documentationSection.Content)</div>
                </li>
            }
        </ul>
    </div>
}

