@using ForgeTrust.AppSurface.Docs.Models
@model CSharpDocumentation
@{
    var documentationSections = Model.Sections.Where(item => item.Content.Count > 0).ToArray();
    var typeParameters = documentationSections.Where(item => item.Kind == CSharpDocumentationSectionKind.TypeParameter).ToArray();
    var parameters = documentationSections.Where(item => item.Kind == CSharpDocumentationSectionKind.Parameter).ToArray();
    var exceptions = documentationSections.Where(item => item.Kind == CSharpDocumentationSectionKind.Exception).ToArray();
}

@foreach (var documentationSection in documentationSections.Where(item => item.Kind == CSharpDocumentationSectionKind.Summary))
{
    <div class="doc-summary">
        @if (CSharpDocumentationMarkup.HasBlockNodes(documentationSection.Content))
        {
            @await Html.PartialAsync("/Views/Docs/CSharp/_XmlNodes.cshtml", documentationSection.Content)
        }
        else
        {
            <p>@await Html.PartialAsync("/Views/Docs/CSharp/_XmlNodes.cshtml", documentationSection.Content)</p>
        }
    </div>
}

@if (typeParameters.Length > 0)
{
    <div class="doc-typeparams">
        @await Html.PartialAsync("/Views/Docs/CSharp/_DocumentationHeading.cshtml", "Type parameters")
        <ul>
            @foreach (var documentationSection in typeParameters)
            {
                <li>
                    @if (!string.IsNullOrWhiteSpace(documentationSection.Name))
                    {
                        <code>@documentationSection.Name</code>
                    }
                    <div>@await Html.PartialAsync("/Views/Docs/CSharp/_XmlNodes.cshtml", documentationSection.Content)</div>
                </li>
            }
        </ul>
    </div>
}

@if (parameters.Length > 0)
{
    <div class="doc-params">
        @await Html.PartialAsync("/Views/Docs/CSharp/_DocumentationHeading.cshtml", "Parameters")
        <ul>
