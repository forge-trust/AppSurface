<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageDescription>Release metadata contracts used transitively by AppSurface Docs and release tooling.</PackageDescription>
    <PackageTags>appsurface;release;contracts;metadata</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\Web\ForgeTrust.AppSurface.Docs\wwwroot\docs\docs-version-switch.js" Link="Assets\docs-version-switch.js" LogicalName="ForgeTrust.AppSurface.ReleaseContracts.Assets.docs-version-switch.js" />
    <EmbeddedResource Include="..\..\Web\ForgeTrust.AppSurface.Docs\wwwroot\docs\docs-version-switch.css" Link="Assets\docs-version-switch.css" LogicalName="ForgeTrust.AppSurface.ReleaseContracts.Assets.docs-version-switch.css" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Cli" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Cli.Tests" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Docs" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Docs.Tests" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Release" />
    <InternalsVisibleTo Include="ForgeTrust.AppSurface.Release.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" />
  </ItemGroup>
</Project>
