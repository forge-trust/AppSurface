<Project>
  <UsingTask TaskName="AppSurfacePublishPreflightTask"
             AssemblyFile="$(MSBuildThisFileDirectory)bin/Release/net10.0/ForgeTrust.AppSurface.PublishPreflight.dll" />

  <!-- ComputeFilesToPublish precedes both SDK copy pipelines. Do not run the static
       split target here: its AfterTargets targets copy files. Reuse its SDK tasks
       on a private manifest snapshot without mutating the ordinary publish items. -->
  <Target Name="AppSurfaceCheckPublishPaths"
          AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="_ComputeResolvedFilesToPublishTypes">
    <Error Code="ASPUB003" Condition="!$([MSBuild]::IsOSPlatform('Linux'))"
           Text="Path check: the publish preflight requires Linux." />
    <Error Code="ASPUB003" Condition="'$(Configuration)' != 'Release' Or '$(SelfContained)' == 'true' Or '$(RuntimeIdentifier)' != '' Or '$(PublishSingleFile)' == 'true'"
           Text="Path check: use a framework-dependent Release publish without a runtime identifier or single-file bundling." />
    <Error Code="ASPUB003" Condition="'$(AppSurfacePreflightReceiptDirectory)' == '' Or !Exists('$(AppSurfacePreflightReceiptDirectory)')"
           Text="Path check: a fresh preflight receipt directory is required; use the pilot script." />
    <Error Code="ASPUB003" Condition="'$(StaticWebAssetPublishManifestPath)' == '' Or !Exists('$(StaticWebAssetPublishManifestPath)')"
           Text="Path check: the SDK static web assets publish manifest is missing." />

    <ReadStaticWebAssetsManifestFile ManifestPath="$(StaticWebAssetPublishManifestPath)">
      <Output TaskParameter="Assets" ItemName="_AppSurfaceManifestAssets" />
    </ReadStaticWebAssetsManifestFile>
    <ComputeStaticWebAssetsForCurrentProject Assets="@(_AppSurfaceManifestAssets)"
                                             ProjectMode="$(StaticWebAssetProjectMode)"
                                             AssetKind="Publish"
                                             Source="$(PackageId)">
      <Output TaskParameter="StaticWebAssets" ItemName="_AppSurfaceProjectPublishAssets" />
    </ComputeStaticWebAssetsForCurrentProject>
    <PropertyGroup>
      <_AppSurfaceStaticPrefix>wwwroot</_AppSurfaceStaticPrefix>
      <_AppSurfaceStaticPrefix Condition="'$(StaticWebAssetProjectMode)' == 'Root'">wwwroot/$(StaticWebAssetBasePath)</_AppSurfaceStaticPrefix>
    </PropertyGroup>
    <ComputeStaticWebAssetsTargetPaths Assets="@(_AppSurfaceProjectPublishAssets)" PathPrefix="$(_AppSurfaceStaticPrefix)">
      <Output TaskParameter="AssetsWithTargetPath" ItemName="_AppSurfaceUnfilteredStaticPaths" />
    </ComputeStaticWebAssetsTargetPaths>
    <ItemGroup>
      <_AppSurfaceStaticPublishPaths Include="@(_AppSurfaceUnfilteredStaticPaths)"
                                    Condition="'%(_AppSurfaceUnfilteredStaticPaths.CopyToPublishDirectory)' == 'Always' Or '%(_AppSurfaceUnfilteredStaticPaths.CopyToPublishDirectory)' == 'PreserveNewest'" />
    </ItemGroup>
    <AppSurfacePublishPreflightTask Phase="paths"
                                   RepositoryDirectory="$(MSBuildThisFileDirectory)../.."
                                   ProjectDirectory="$(MSBuildProjectDirectory)"
                                   OrdinaryFiles="@(_ResolvedFileToPublishPreserveNewest);@(_ResolvedFileToPublishAlways)"
                                   StaticFiles="@(_AppSurfaceStaticPublishPaths)" />
    <WriteLinesToFile File="$(AppSurfacePreflightReceiptDirectory)/paths.ok" Lines="paths checked" Overwrite="true" />
  </Target>

  <!-- The Web SDK's AfterPublish phase follows its direct output transforms. -->
  <Target Name="AppSurfaceCheckPublishPermissions" AfterTargets="AfterPublish">
    <Error Code="ASPUB003" Condition="!Exists('$(AppSurfacePreflightReceiptDirectory)/paths.ok')"
           Text="Permissions check: the pre-copy path check did not complete." />
    <AppSurfacePublishPreflightTask Phase="permissions" PublishDirectory="$(PublishDir)" />
    <WriteLinesToFile File="$(AppSurfacePreflightReceiptDirectory)/permissions.ok" Lines="permissions checked" Overwrite="true" />
  </Target>
</Project>
