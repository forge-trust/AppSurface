<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Coverage/ForgeTrust.AppSurface.Coverage/ForgeTrust.AppSurface.Coverage.csproj" />
    <Compile Remove="fixtures/**/*.cs" />
    <Compile Remove="examples/**/*.cs" />
    <None Include="fixtures/**/*" Exclude="fixtures/**/bin/**;fixtures/**/obj/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="examples/**/*.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="examples/**/*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
