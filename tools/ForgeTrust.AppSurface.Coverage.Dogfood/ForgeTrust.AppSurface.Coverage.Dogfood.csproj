<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../shared/NativeCoverageProducerInventory.cs" Link="Shared/NativeCoverageProducerInventory.cs" />
    <Compile Include="../ForgeTrust.AppSurface.Evidence.Validation/PackedCandidateArchive.cs" Link="PackedCandidateArchive.cs" />
    <Compile Include="../ForgeTrust.AppSurface.Evidence.Validation/PackedCandidatePackages.cs" Link="PackedCandidatePackages.cs" />
    <Compile Include="../ForgeTrust.AppSurface.Evidence.Validation/PackedProofProcess.cs" Link="PackedProofProcess.cs" />
    <Compile Include="../ForgeTrust.AppSurface.Evidence.Validation/PackedProofProgress.cs" Link="PackedProofProgress.cs" />
    <Compile Include="../ForgeTrust.AppSurface.Evidence.Validation/PrivatePackageEdges.cs" Link="PrivatePackageEdges.cs" />
    <ProjectReference Include="../../Coverage/ForgeTrust.AppSurface.Coverage/ForgeTrust.AppSurface.Coverage.csproj" />
    <EmbeddedResource Include="../../.github/workflows/native-coverage-test-projects.txt">
      <LogicalName>ForgeTrust.AppSurface.Coverage.Dogfood.native-coverage-test-projects.txt</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="../../.github/workflows/native-coverage-test-selectors.txt">
      <LogicalName>ForgeTrust.AppSurface.Coverage.Dogfood.native-coverage-test-selectors.txt</LogicalName>
    </EmbeddedResource>
    <Compile Remove="fixtures/**/*.cs" />
    <Compile Remove="examples/**/*.cs" />
    <None Include="fixtures/**/*" Exclude="fixtures/**/bin/**;fixtures/**/obj/**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="examples/**/*.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Update="examples/**/*.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
